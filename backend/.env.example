# Copy this file to .env and replace the placeholders.
# Never commit your actual .env file.

# PostgreSQL database connection
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# JWT signing and verification secret.
# Generate a strong random secret for your own environment.
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"

# Backend server port (optional; defaults to 3000)
PORT=3000

# Allowed frontend origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173
