
 // use prisma-8

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole        @default(STAFF)
  isActive       Boolean         @default(true)
  createdAt      TimestamptzString @default(now())
  updatedAt      DateTime(as: string) @onCreate(now()) @onUpdate(now())
  stockMovements StockMovement[]
  sales          Sale[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   TimestamptzString @default(now())
  updatedAt   DateTime(as: string) @onCreate(now()) @onUpdate(now())
  products    Product[]
  @@index(expression: sql`lower(btrim(name))`, unique: true, name: "category_name_normalized_unique")
}

model Product {
  id              Int             @id @default(autoincrement())
  sku             String          @unique
  name            String
  description     String?
  costPrice       Decimal
  sellingPrice    Decimal
  stockQuantity   Int             @default(0)
  reorderLevel    Int             @default(10)
  isActive        Boolean         @default(true)
  category        Category        @relation(fields: [categoryId], references: [id])
  categoryId      Int
  createdAt       TimestamptzString @default(now())
  updatedAt       DateTime(as: string) @onCreate(now()) @onUpdate(now())
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  @@check(expression: sql`"stockQuantity" >= 0 AND "reorderLevel" >= 0 AND "costPrice" >= 0 AND "sellingPrice" >= 0`, name: "product_nonnegative_values")
}

model StockMovement {
  id            Int               @id @default(autoincrement())
  type          StockMovementType
  quantity      Int
  quantityAfter Int
  notes         String?
  product       Product           @relation(fields: [productId], references: [id])
  productId     Int
  user          User              @relation(fields: [userId], references: [id])
  userId        Int
  createdAt     TimestamptzString @default(now())
  @@check(expression: sql`"quantity" > 0 AND "quantityAfter" >= 0`, name: "stock_movement_valid_quantities")
}

model Sale {
  id            Int        @id @default(autoincrement())
  saleNumber    String     @unique
  status        SaleStatus @default(COMPLETED)
  subtotal      Decimal
  discount      Decimal    @default(0)
  total         Decimal
  notes         String?
  soldBy        User       @relation(fields: [soldById], references: [id])
  soldById      Int
  items         SaleItem[]
  createdAt     TimestamptzString @default(now())
  updatedAt     DateTime(as: string) @onCreate(now()) @onUpdate(now())
  @@check(expression: sql`"subtotal" >= 0 AND "discount" >= 0 AND "total" >= 0 AND "discount" <= "subtotal"`, name: "sale_valid_amounts")
}

model SaleItem {
  id                Int     @id @default(autoincrement())
  sale              Sale    @relation(fields: [saleId], references: [id])
  saleId            Int
  product           Product @relation(fields: [productId], references: [id])
  productId         Int
  quantity          Int
  unitPrice         Decimal
  unitCost          Decimal
  lineTotal         Decimal
  @@check(expression: sql`"quantity" > 0 AND "unitPrice" >= 0 AND "unitCost" >= 0 AND "lineTotal" >= 0`, name: "sale_item_valid_values")
}
